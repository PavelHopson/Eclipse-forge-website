{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eclipse-forge.ru/schemas/growth/content-item.v1.json",
  "title": "Eclipse Growth OS Content Item",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "project", "audience", "problem", "funnelStage", "hook", "thesis", "evidenceIds", "format", "channel", "cta", "assets", "owner", "kpi", "repurposing", "status"],
  "properties": {
    "id": { "type": "string", "pattern": "^content-[a-z0-9-]+$" },
    "project": { "type": "string", "minLength": 1 },
    "audience": { "type": "string", "minLength": 1 },
    "problem": { "type": "string", "minLength": 1 },
    "funnelStage": { "enum": ["awareness", "consideration", "conversion", "retention"] },
    "hook": { "type": "string", "minLength": 1, "maxLength": 300 },
    "thesis": { "type": "string", "minLength": 1, "maxLength": 1500 },
    "evidenceIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^evidence-[a-z0-9-]+$" } },
    "format": { "type": "string", "minLength": 1 },
    "channel": { "type": "string", "minLength": 1 },
    "cta": { "type": "string", "minLength": 1 },
    "assets": { "type": "array", "items": { "type": "string" } },
    "owner": { "type": "string", "minLength": 1 },
    "kpi": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "repurposing": { "type": "array", "items": { "type": "string" } },
    "status": { "enum": ["idea", "verified", "draft", "review", "ready", "published", "measured"] },
    "publishedAt": { "type": "string", "format": "date-time" },
    "measurementNote": { "type": "string", "maxLength": 2000 }
  }
}
